    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@playwright/test": "^1.51.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.1.0"
  }
